{% sw_extends '@Storefront/storefront/component/payment/payment-method.html.twig' %}

{% set isFlizpay = payment.handlerIdentifier == 'FLIZpay\\FlizpayForShopware\\Handler\\FlizpayPaymentHandler' %}
{% set flizpayCheckout = page.extensions.flizpayCheckout|default(null) %}
{# Without a public id the element has nothing to fetch, so the plain label stays. #}
{% set flizpayCheckoutReady = isFlizpay and flizpayCheckout and flizpayCheckout.publicId %}

{% block component_payment_method_label %}
    {# The extended template defines `selectedPaymentMethodId` in its own body, which Twig runs
       after this file's top-level code. Resolving it here keeps it in scope for the nested blocks. #}
    {% set isSelectedPaymentMethod = payment.id is same as(selectedPaymentMethodId is defined ? selectedPaymentMethodId : context.paymentMethod.id) %}

    <label class="form-check-label payment-method-label{% if isFlizpay %} flizpay-payment-method-label{% endif %}"
           for="paymentMethod{{ payment.id }}">

        {% block component_payment_method_image %}
            {% if payment.media %}
                {% sw_thumbnails 'payment-method-image-thumbnails' with {
                    media: payment.media,
                    sizes: {
                        default: '100px'
                    },
                    attributes: {
                        class: 'payment-method-image',
                        alt: (payment.media.translated.alt ?: payment.translated.name),
                        title: (payment.media.translated.title ?: payment.translated.name)
                    }
                } %}
            {% endif %}
        {% endblock %}

        {% block component_payment_method_description %}
            <div class="payment-method-description{% if isFlizpay %} flizpay-payment-description{% endif %}">
                {% set paymentName = payment.translated.name %}

                {% block component_payment_method_name %}
                    <strong>
                        {%- if flizpayCheckoutReady and flizpayCheckout.showHeadline -%}
                            {% sw_include '@Storefront/storefront/component/flizpay/checkout.html.twig' with { surface: 'title' } %}
                        {%- else -%}
                            {{ paymentName }}
                        {%- endif -%}
                    </strong>
                {% endblock %}

                {# FLIZpay: the offer text replaces the stored description, and only while selected. #}
                {% if isFlizpay %}
                    {% if flizpayCheckoutReady and flizpayCheckout.showDescription and isSelectedPaymentMethod %}
                        {% block flizpay_payment_method_description_text %}
                            <div class="flizpay-description-text">
                                {% sw_include '@Storefront/storefront/component/flizpay/checkout.html.twig' with { surface: 'description' } %}
                            </div>
                        {% endblock %}
                    {% endif %}
                {% elseif payment.translated.description and isSelectedPaymentMethod %}
                    {% set paymentDescription = payment.translated.description|raw %}
                    {% set paymentDescriptionTitle = payment.translated.description|striptags|raw %}
                    {% set paymentDescription = (paymentDescription|length > 75 ? paymentDescription[:75] ~ ' ...' : paymentDescription) %}

                    {% block component_payment_method_description_text %}
                        <p class="mb-0" title="{{ paymentDescriptionTitle }}">{{ paymentDescription }}</p>
                    {% endblock %}
                {% endif %}
            </div>
        {% endblock %}

        {# FLIZpay logo badge on the right - controlled by showLogo setting #}
        {% if isFlizpay and flizpayCheckout and flizpayCheckout.showLogo %}
            {% block flizpay_logo_badge %}
               <img src="{{ asset('bundles/flizpayforshopware/fliz-checkout-logo.svg', 'asset') }}" alt="FLIZpay Logo">
            {% endblock %}
        {% endif %}
    </label>
{% endblock %}
